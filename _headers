# Antônia Decoração — Cloudflare Pages
# Regras de cache e cabeçalhos de segurança.
#
# ATENÇÃO: estas regras aplicam-se apenas aos ficheiros estáticos.
# As respostas da API (Pages Functions em /api/*) enviam os seus próprios
# cabeçalhos (ver functions/_middleware.js e as Pages Functions).

# Cabeçalhos de segurança para todo o site
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Páginas HTML — nunca em cache, para publicar alterações de imediato
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# CSS e JavaScript — cache curto (os ficheiros usam ?v= para limpar a cache)
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Imagens, logótipos e vídeos — cache longo
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# A API nunca deve ser servida a partir de cache do browser
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
